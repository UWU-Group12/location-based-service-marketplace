rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function currentUser() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      );
    }

    function isCustomer() {
      return signedIn()
        && currentUser().data.role == 'customer';
    }

    function isProvider() {
      return signedIn()
        && currentUser().data.role == 'provider';
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.admin == true;
    }

    function isActiveLocation(locationId) {
      return exists(
          /databases/$(database)/documents/locations/$(locationId)
        )
        && get(
          /databases/$(database)/documents/locations/$(locationId)
        ).data.active == true;
    }

    function isValidProviderProfileCreate(providerId) {
      return request.resource.data.keys().hasAll([
          'providerId',
          'displayName',
          'categoryIds',
          'experienceYears',
          'workingDays',
          'workingHours',
          'baseLocation',
          'locationId',
          'serviceRadiusKm',
          'availabilityStatus',
          'verificationStatus',
          'ratingAverage',
          'reviewCount',
          'completedJobCount',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.providerId == providerId
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.categoryIds is list
        && request.resource.data.categoryIds.size() > 0
        && request.resource.data.experienceYears is int
        && request.resource.data.experienceYears >= 0
        && request.resource.data.workingDays is list
        && request.resource.data.workingDays.size() > 0
        && request.resource.data.workingHours is string
        && request.resource.data.workingHours.size() > 0
        && request.resource.data.baseLocation is latlng
        && request.resource.data.locationId is string
        && request.resource.data.locationId.size() > 0
        && isActiveLocation(request.resource.data.locationId)
        && request.resource.data.serviceRadiusKm is number
        && request.resource.data.serviceRadiusKm in [5, 10, 15, 20, 30]
        && request.resource.data.availabilityStatus == 'unavailable'
        && request.resource.data.verificationStatus == 'pending'
        && request.resource.data.ratingAverage == 0
        && request.resource.data.reviewCount == 0
        && request.resource.data.completedJobCount == 0;
    }

    function isValidVerificationCreate(providerId) {
      return request.resource.data.keys().hasAll([
          'providerId',
          'documentType',
          'frontDocumentPath',
          'backDocumentPath',
          'certificatePaths',
          'status',
          'submittedAt'
        ])
        && request.resource.data.providerId == providerId
        && request.resource.data.documentType == 'national_id'
        && request.resource.data.frontDocumentPath is string
        && request.resource.data.frontDocumentPath.size() > 0
        && request.resource.data.backDocumentPath is string
        && request.resource.data.backDocumentPath.size() > 0
        && request.resource.data.certificatePaths is list
        && request.resource.data.status == 'pending'
        && request.resource.data.submittedAt == request.time
        && request.resource.data.reviewedBy == null
        && request.resource.data.reviewedAt == null
        && request.resource.data.rejectionReason == null;
    }

    function isValidServiceRequestCreate() {
      return request.resource.data.keys().hasAll([
          'customerId',
          'providerId',
          'categoryId',
          'title',
          'description',
          'serviceLocation',
          'requestStatus',
          'quotationStatus',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.providerId is string
        && request.resource.data.providerId.size() > 0
        && request.resource.data.categoryId is string
        && request.resource.data.categoryId.size() > 0
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.serviceLocation is map
        && request.resource.data.serviceLocation.point is latlng
        && request.resource.data.serviceLocation.addressText is string
        && request.resource.data.serviceLocation.addressText.size() > 0
        && request.resource.data.requestStatus == 'submitted'
        && request.resource.data.quotationStatus == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }
    match /users/{userId} {
      allow create: if isOwner(userId);

      allow read: if isOwner(userId) || isAdmin();

      allow update: if isAdmin() ||
        (
          isOwner(userId) &&
          request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'displayName',
              'phoneNumber',
              'photoPath',
              'profileCompleted',
              'updatedAt'
            ])
        );

      allow delete: if isAdmin();
    }

    match /providerProfiles/{providerId} {
      allow read: if
        (
          signedIn() &&
          resource.data.verificationStatus == 'verified'
        )
        || isOwner(providerId)
        || isAdmin();

      allow create: if
        isOwner(providerId)
        && isProvider()
        && isValidProviderProfileCreate(providerId);

      allow update: if isAdmin() ||
        (
          isOwner(providerId) &&
          request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'displayName',
              'profileImagePath',
              'bio',
              'categoryIds',
              'experienceYears',
              'workingDays',
              'workingHours',
              'baseLocation',
              'locationId',
              'serviceRadiusKm',
              'availabilityStatus',
              'updatedAt'
            ])
          && request.resource.data.experienceYears is int
          && request.resource.data.experienceYears >= 0
          && request.resource.data.workingDays is list
          && request.resource.data.workingDays.size() > 0
          && request.resource.data.workingHours is string
          && request.resource.data.workingHours.size() > 0
          && request.resource.data.baseLocation is latlng
          && request.resource.data.locationId is string
          && request.resource.data.locationId.size() > 0
          && isActiveLocation(request.resource.data.locationId)
          && request.resource.data.serviceRadiusKm is number
          && request.resource.data.serviceRadiusKm in [5, 10, 15, 20, 30]
        );
    }

    match /providerVerifications/{providerId} {
      allow create: if
        (
          isOwner(providerId)
          && isProvider()
          && isValidVerificationCreate(providerId)
        )
        || isAdmin();

      allow read: if isOwner(providerId) || isAdmin();
      allow update, delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /locations/{locationId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /serviceRequests/{requestId} {
      allow create: if
        isCustomer()
        && request.resource.data.customerId == request.auth.uid
        && isValidServiceRequestCreate();

      allow read: if
        isAdmin()
        || resource.data.customerId == request.auth.uid
        || resource.data.providerId == request.auth.uid;

      // Sensitive state changes should use strict transition rules
      // or trusted Cloud Functions.
      allow update: if isAdmin();
    }

    match /quotations/{quotationId} {
      allow read: if
        isAdmin()
        || resource.data.customerId == request.auth.uid
        || resource.data.providerId == request.auth.uid;

      allow create: if
        isProvider()
        && request.resource.data.providerId == request.auth.uid;

      allow update, delete: if isAdmin();
    }
  }
}