rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Is the user logged in?
    function signedIn() {
      return request.auth != null;
    }

    // Is this the logged-in user's own document?
    function isMe(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Admin = user with custom claim admin: true
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    // ---------- USERS ----------
    match /users/{userId} {
      allow read, create: if isMe(userId) || isAdmin();

      // User can edit own data, but cannot change own role
      allow update: if isAdmin()
        || (isMe(userId)
            && request.resource.data.role == resource.data.role);

      allow delete: if isAdmin();
    }

    // ---------- PROVIDER PROFILES ----------
    match /providerProfiles/{providerId} {
      allow read: if signedIn();

      // New profile must start as 'pending'
      allow create: if isMe(providerId)
        && request.resource.data.verificationStatus == 'pending';

      // Provider can edit own profile, but cannot verify himself
      allow update: if isAdmin()
        || (isMe(providerId)
            && request.resource.data.verificationStatus
               == resource.data.verificationStatus);

      allow delete: if isAdmin();
    }

    // ---------- PROVIDER VERIFICATIONS (ID documents) ----------
    match /providerVerifications/{providerId} {
      allow read, create: if isMe(providerId) || isAdmin();
      allow update, delete: if isAdmin();
    }

    // ---------- CATEGORIES ----------
    match /categories/{categoryId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ---------- SERVICE REQUESTS ----------
    match /serviceRequests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.customerId == request.auth.uid;

      // Only the customer and provider of this request
      allow read, update: if isAdmin()
        || resource.data.customerId == request.auth.uid
        || resource.data.providerId == request.auth.uid;

      allow delete: if isAdmin();
    }

    // ---------- QUOTATIONS ----------
    match /quotations/{quotationId} {
      // resource == null lets the app listen before the quotation exists
      allow read: if signedIn() && (
        resource == null
        || isAdmin()
        || resource.data.customerId == request.auth.uid
        || resource.data.providerId == request.auth.uid
      );

      allow create: if signedIn()
        && request.resource.data.providerId == request.auth.uid;

      allow update: if isAdmin()
        || resource.data.customerId == request.auth.uid
        || resource.data.providerId == request.auth.uid;

      allow delete: if isAdmin();
    }
  }
}
